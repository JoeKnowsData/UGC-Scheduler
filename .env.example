# Copy to .env and fill in. Only platforms with credentials show a Connect button.

# Public HTTPS address of this app. OAuth redirect URIs are BASE_URL/auth/<platform>/callback
BASE_URL=http://localhost:3000
PORT=3000
# Protects the whole app with a login prompt (username: anything). Set this before exposing it online.
APP_PASSWORD=

# Meta app (developers.facebook.com) -> Facebook Login for Business, used for Facebook Page Reels
FB_APP_ID=
FB_APP_SECRET=
# Same Meta app -> Instagram product -> "API setup with Instagram login" (has its own app id/secret)
IG_APP_ID=
IG_APP_SECRET=
META_API_VERSION=v23.0

# Google Cloud project with YouTube Data API v3 enabled, OAuth client type "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# public | unlisted | private
YOUTUBE_PRIVACY=public

# TikTok for Developers app with Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok refuses localhost redirects. Optional HTTPS page that forwards to BASE_URL/auth/tiktok/callback with the same query string.
TIKTOK_REDIRECT_URI=
# direct = posts straight to the profile; inbox = sends it to your TikTok inbox to finish in the app
TIKTOK_MODE=direct
# Unaudited TikTok apps may only post SELF_ONLY. Switch to PUBLIC_TO_EVERYONE after the audit passes.
TIKTOK_PRIVACY=SELF_ONLY

# 1 = fake every platform (no real posting), for trying the app out
DRY_RUN=0

# Instagram only accepts a public link to the video. If this app already has a public HTTPS address, put it here.
# Otherwise a temporary cloudflared quick tunnel is opened for each Instagram post and closed afterwards.
PUBLIC_URL=
CLOUDFLARED_PATH=
