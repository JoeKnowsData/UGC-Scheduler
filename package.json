{
  "name": "ugc-scheduler",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted scheduler that publishes one video as a Reel/Short/TikTok to many accounts at a set time.",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "demo": "DRY_RUN=1 node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2"
  }
}
